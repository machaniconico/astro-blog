---
const today = new Date();
---

<footer>
	<div class="footer-shell">
		<div class="footer-id">
			<p class="footer-kicker">Field note / maker archive</p>
			<p class="copyright">&copy; {today.getFullYear()} 個人開発のすゝめ. All rights reserved.</p>
		</div>
		<a
			class="github-link"
			href="https://github.com/machaniconico"
			target="_blank"
			rel="noopener noreferrer"
		>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
			<span>GitHub / machaniconico</span>
			<span class="external-mark" aria-hidden="true">↗</span>
		</a>
	</div>
</footer>
<style>
	footer {
		--footer-paper: #f3f0e7;
		--footer-ink: #263042;
		--footer-muted: #6d7480;
		--footer-cobalt: #174fc9;
		border-top: 3px solid var(--footer-cobalt);
		padding: 1.5rem 20px 1.75rem;
		background: var(--footer-paper);
	}
	.footer-shell {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}
	.footer-id {
		min-width: 0;
	}
	.footer-kicker {
		margin: 0 0 0.35rem;
		color: var(--footer-cobalt);
		font-family: var(--font-mono);
		font-size: 0.61rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		line-height: 1.2;
		text-transform: uppercase;
	}
	.copyright {
		margin: 0;
		color: var(--footer-muted);
		font-size: 0.72rem;
		line-height: 1.5;
	}
	.github-link {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 0.55rem;
		color: var(--footer-ink);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		transition: color 160ms ease;
	}
	.github-link:hover {
		color: var(--footer-cobalt);
		opacity: 1;
	}
	.github-link:focus-visible {
		outline: 2px solid var(--footer-cobalt);
		outline-offset: 4px;
	}
	.external-mark {
		color: var(--footer-cobalt);
	}
	@media (max-width: 720px) {
		footer {
			padding: 1.1rem 14px 1.25rem;
		}
		.footer-shell {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.6rem;
		}
		.github-link {
			width: max-content;
			max-width: 100%;
		}
		.github-link span:not(.external-mark) {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.github-link {
			transition: none;
		}
	}
</style>
