---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="メインナビゲーション">
		<h2>
			<a href="/" class="wordmark">
				<span class="wordmark-meta" aria-hidden="true">
					<span class="status-dot"></span>
					Field note / 001
				</span>
				<span class="wordmark-title">{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/works">作品</HeaderLink>
			<HeaderLink href="/blog">ブログ</HeaderLink>
			<HeaderLink href="/diary">日記</HeaderLink>
		</div>
		<div class="social-links">
			<a
				class="github-link"
				href="https://github.com/machaniconico"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		--chrome-paper: #fffdf8;
		--chrome-ink: #172033;
		--chrome-muted: #667085;
		--chrome-rule: #d7d1c3;
		--chrome-cobalt: #174fc9;
		--chrome-vermilion: #e6482e;
		margin: 0;
		padding: 0 20px;
		background: var(--chrome-paper);
		border-top: 3px solid var(--chrome-cobalt);
		border-bottom: 1px solid var(--chrome-rule);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		min-width: 0;
	}
	h2 a,
	h2 a.active {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 2px;
		min-height: 44px;
		padding: 0;
		text-decoration: none;
		color: var(--chrome-ink);
		font-weight: 700;
	}
	h2 a:hover {
		color: var(--chrome-cobalt);
		opacity: 1;
	}
	.wordmark-meta {
		display: flex;
		align-items: center;
		gap: 7px;
		color: var(--chrome-cobalt);
		font-family: var(--font-mono);
		font-size: 0.5rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		line-height: 1;
		text-transform: uppercase;
	}
	.status-dot {
		width: 6px;
		height: 6px;
		flex: 0 0 auto;
		border-radius: 50%;
		background: var(--chrome-vermilion);
	}
	.wordmark-title {
		font-family: var(--font-serif);
		font-size: 1.02rem;
		line-height: 1.2;
	}
	nav {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: minmax(240px, 1fr) auto 48px;
		align-items: center;
		height: 68px;
	}
	.internal-links {
		display: flex;
		height: 100%;
		align-items: center;
		border-left: 1px solid var(--chrome-rule);
	}
	nav a {
		display: inline-flex;
		box-sizing: border-box;
		min-height: 44px;
		align-items: center;
		padding: 0 1rem;
		position: relative;
		color: var(--chrome-muted);
		text-decoration: none;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		transition: color 160ms ease, background-color 160ms ease;
	}
	nav a:hover {
		color: var(--chrome-cobalt);
		background: #f5f2e9;
		opacity: 1;
	}
	nav a.active {
		color: var(--chrome-cobalt);
		text-decoration: none;
	}
	nav a.active::after {
		content: "";
		position: absolute;
		right: 1rem;
		bottom: -1px;
		left: 1rem;
		height: 3px;
		background: var(--chrome-cobalt);
	}
	nav a:focus-visible {
		outline: 2px solid var(--chrome-cobalt);
		outline-offset: -4px;
	}
	.social-links {
		display: flex;
		height: 100%;
		align-items: center;
		border-left: 1px solid var(--chrome-rule);
	}
	.social-links a.github-link {
		width: 48px;
		height: 100%;
		justify-content: center;
		color: var(--chrome-muted);
		padding: 0;
	}
	.social-links a.github-link:hover {
		color: var(--chrome-cobalt);
		opacity: 1;
	}
	@media (max-width: 720px) {
		header {
			border-top-width: 2px;
			padding: 0;
		}
		nav {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			height: auto;
		}
		h2 {
			display: flex;
			min-width: 0;
			min-height: 42px;
			align-items: center;
			padding: 0 14px;
		}
		h2 a,
		h2 a.active {
			flex-direction: row;
			gap: 9px;
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.wordmark-meta {
			gap: 0;
			font-size: 0;
		}
		.wordmark-title {
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			font-size: 0.94rem;
		}
		.internal-links {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			height: auto;
			border-top: 1px solid var(--chrome-rule);
			border-left: 0;
		}
		.social-links {
			display: none;
		}
		.internal-links a {
			min-width: 0;
			min-height: 44px;
			height: 44px;
			justify-content: center;
			padding: 0 4px;
			border-right: 1px solid var(--chrome-rule);
			font-size: 0.67rem;
			letter-spacing: 0.05em;
			white-space: nowrap;
		}
		.internal-links a:last-child {
			border-right: 0;
		}
		.internal-links a.active::after {
			right: 8px;
			left: 8px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		nav a {
			transition: none;
		}
	}
</style>
