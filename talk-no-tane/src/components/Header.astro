---
const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
const links = [
	{ href: '/', label: 'ホーム' },
	{ href: '/gacha', label: 'ガチャ' },
	{ href: '/topics', label: 'ネタ一覧' },
	{ href: '/categories', label: 'カテゴリ' },
	{ href: '/about', label: 'このサイト' },
];
---

<header class="site-header">
	<div class="container header-inner">
		<a href="/" class="brand">
			<span class="brand-mark">🌱</span>
			<span class="brand-name">トークのタネ</span>
		</a>
		<nav aria-label="メインナビゲーション">
			<ul>
				{
					links.map((l) => (
						<li>
							<a href={l.href} class:list={[{ active: isActive(l.href) }]}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--text);
		text-decoration: none;
	}
	.brand-mark {
		font-size: 1.4rem;
	}
	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a {
		display: inline-block;
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		color: var(--text-soft);
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--text);
		background: var(--bg-soft);
	}
	nav a.active {
		color: var(--accent-dark);
		background: var(--accent-soft);
	}
	@media (max-width: 640px) {
		.brand-name {
			display: none;
		}
		nav a {
			padding: 0.4rem 0.6rem;
			font-size: 0.85rem;
		}
	}
</style>
